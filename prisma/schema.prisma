generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @db.Uuid
  email                String    @unique
  name                 String?
  avatarUrl            String?   @map("avatar_url")
  emailVerified        Boolean   @default(false) @map("email_verified")
  isOnboardingComplete Boolean   @default(false) @map("is_onboarding_complete")
  creator              Creator?
  invoices             Invoice[]
  mediaKit             MediaKit?
  accounts             Account[]
  sessions             Session[]
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

enum CreatorType {
  Micro
  Mid
  Macro
}

enum InvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
  Archived
}

enum MediaKitCategory {
  fashion
  beauty
  fitness
  gaming
  technology
  lifestyle
  travel
  food
  business
  other
}

enum MediaKitCurrency {
  USD
  EUR
  GBP
  INR
}

model Account {
  id         String  @id @db.Uuid
  accountId  String  @map("account_id")
  providerId String  @map("provider_id")
  issuer     String?
  userId     String  @map("user_id") @db.Uuid
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([issuer, accountId])
  @@index([userId], map: "accounts_user_id_idx")
  @@map("accounts")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

model Creator {
  id              String      @id @db.Uuid
  creatorType     CreatorType @default(Micro) @map("creator_type")
  niche           String?     @map("niche")
  instagramHandle String?     @map("instagram_handle")
  youtubeHandle   String?     @map("youtube_handle")
  bio             String?     @map("bio")
  userId          String      @unique @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("creators")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(Draft)
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  dueDate       DateTime?     @map("due_date")
  paidDate      DateTime?     @map("paid_date")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId, status, dueDate], map: "invoices_user_status_due_date_idx")
  @@index([userId, createdAt(sort: Desc)], map: "invoices_user_created_at_idx")
  @@map("invoices")
}

model MediaKit {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String                    @unique @map("user_id") @db.Uuid
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String                    @map("display_name")
  handle           String
  category         MediaKitCategory
  bio              String?
  avatarUrl        String?                   @map("avatar_url")
  followers        Int                       @default(0)
  avgReelViews     Int                       @default(0) @map("avg_reel_views")
  avgLikes         Int                       @default(0) @map("avg_likes")
  avgComments      Int                       @default(0) @map("avg_comments")
  avgStoryViews    Int                       @default(0) @map("avg_story_views")
  engagementRate   Decimal                   @map("engagement_rate") @db.Decimal(5, 2)
  topAgeGroups     String                    @map("top_age_groups")
  womenPercentage  Decimal                   @map("women_percentage") @db.Decimal(5, 2)
  cities           String[]
  countries        String[]
  brandsWorkedWith String?                   @map("brands_worked_with")
  currency         MediaKitCurrency          @default(INR)
  ratePerThousand  Decimal                   @map("rate_per_thousand") @db.Decimal(12, 2)
  paymentTerms     String                    @map("payment_terms")
  addOns           Json                      @map("add_ons")
  contactEmail     String                    @map("contact_email")
  contactPhone     String?                   @map("contact_phone")
  contactWebsite   String?                   @map("contact_website")
  workItems        MediaKitWorkItem[]
  rateDeliverables MediaKitRateDeliverable[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([userId, updatedAt(sort: Desc)], map: "media_kits_user_updated_at_idx")
  @@map("media_kits")
}

model MediaKitWorkItem {
  id         String   @id @default(uuid()) @db.Uuid
  mediaKitId String   @map("media_kit_id") @db.Uuid
  mediaKit   MediaKit @relation(fields: [mediaKitId], references: [id], onDelete: Cascade)
  title      String
  url        String
  views      Int      @default(0)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([mediaKitId, orderIndex], map: "media_kit_work_items_kit_order_idx")
  @@map("media_kit_work_items")
}

model MediaKitRateDeliverable {
  id         String   @id @default(uuid()) @db.Uuid
  mediaKitId String   @map("media_kit_id") @db.Uuid
  mediaKit   MediaKit @relation(fields: [mediaKitId], references: [id], onDelete: Cascade)
  title      String
  price      Decimal  @db.Decimal(12, 2)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([mediaKitId, orderIndex], map: "media_kit_rate_deliverables_kit_order_idx")
  @@map("media_kit_rate_deliverables")
}
